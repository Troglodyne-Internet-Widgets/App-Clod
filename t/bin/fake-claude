#!/usr/bin/env perl
use 5.040;
use warnings FATAL => 'all';
use re '/aasx';

# Stands in for claude -p.  It reads the prompt, then prints the stream-json
# lines named by FAKE_CLAUDE_STREAM, and records its arguments, its working
# directory and the prompt where FAKE_CLAUDE_RECORD says.
use Cwd      ();
use IPC::Run ();

my $prompt = do { local $/ = undef; readline \*STDIN };
if ( my $record = $ENV{FAKE_CLAUDE_RECORD} ) {
    open my $fh, '>', $record or die "$record: $!";
    print {$fh} join( "\0", Cwd::getcwd(), $prompt, @ARGV );
    close $fh or die "$record: $!";
}
open my $in, '<', $ENV{FAKE_CLAUDE_STREAM} or die "$ENV{FAKE_CLAUDE_STREAM}: $!";
print {*STDOUT} readline $in;
close $in or die $!;

# A spoke run commits, as the real one does in a worktree.
if ( $ENV{FAKE_CLAUDE_COMMIT} ) {
    my ( $out, $err );
    IPC::Run::run( [ qw{git commit --quiet --allow-empty -m}, 'fake change' ], '>', \$out, '2>', \$err ) or die "git commit: $err";
}
exit( $ENV{FAKE_CLAUDE_EXIT} // 0 );
