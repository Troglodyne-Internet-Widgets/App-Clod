<!doctype html>
<html lang="en" data-bs-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Clod</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.8/css/bootstrap.min.css" integrity="sha512-2bBQCjcnw658Lho4nlXJcc6WkV/UxpE/sAokbXPxQNGqmNdQrWqtw26Ns9kFF/yG792pKR1Sx8/Y1Lf1XN4GKA==" crossorigin="anonymous" referrerpolicy="no-referrer">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.13.1/font/bootstrap-icons.min.css" integrity="sha512-t7Few9xlddEmgd3oKZQahkNI4dS6l80+eGEzFQiqtyVYdvcSG2D3Iub77R20BdotfRPA9caaRkg1tyaJiPmO0g==" crossorigin="anonymous" referrerpolicy="no-referrer">
  <script>
    if (window.matchMedia('(prefers-color-scheme: dark)').matches) document.documentElement.dataset.bsTheme = 'dark';
  </script>
  <style>
    .stat { font-size: 2rem; font-weight: 600; line-height: 1; }
    .harness td, .harness th { white-space: nowrap; }
    .harness td.cell { text-align: center; }
    .summary { max-width: 40rem; }
    /* A button of an action item in the color of the text of its item, which
       its level sets, so it reads in both themes. */
    .act { color: inherit; border-color: currentColor; background-color: transparent; }
    .act:hover, .act:focus-visible { color: inherit; border-color: currentColor; background-color: rgba(127, 127, 127, 0.25); }
  </style>
</head>
<body class="bg-body-tertiary">
  <nav class="navbar bg-body border-bottom mb-3">
    <div class="container-xl">
      <span class="navbar-brand"><i class="bi bi-diagram-3"></i> Clod <small class="text-body-secondary fs-6"><%= $bot %></small></span>
      <span class="d-flex gap-3 align-items-center">
        <small class="text-body-secondary" id="updated"></small>
        <small class="text-body-secondary font-monospace" id="running" title="the commit that the bot runs"></small>
        <a class="btn btn-sm btn-outline-secondary" href="<%= url_for('/minion') %>"><i class="bi bi-list-task"></i> Minion</a>
      </span>
    </div>
  </nav>

  <main class="container-xl">
    <ul class="nav nav-tabs mb-3" role="tablist">
      <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#overview" type="button">Overview</button></li>
      <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#work" type="button">Work</button></li>
      <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#harness" type="button">Harness</button></li>
    </ul>

    <div class="tab-content">
      <section class="tab-pane fade show active" id="overview">
        <div class="row g-3 mb-3" id="cards"></div>
        <div class="card">
          <div class="card-header d-flex align-items-center gap-2">
            <span class="text-nowrap"><i class="bi bi-exclamation-triangle"></i> Action items</span>
            <span class="btn-group btn-group-sm" id="action-filter" role="group" aria-label="Filter the action items by type">
              <button type="button" class="btn btn-outline-danger active" data-level="danger" aria-pressed="true">Failures</button>
              <button type="button" class="btn btn-outline-warning active" data-level="warning" aria-pressed="true">Warnings</button>
              <button type="button" class="btn btn-outline-info active" data-level="info" aria-pressed="true">Info</button>
            </span>
          </div>
          <ul class="list-group list-group-flush" id="actions"></ul>
        </div>
      </section>

      <section class="tab-pane fade" id="work">
        <div class="card mb-3">
          <div class="card-header"><i class="bi bi-gear-wide-connected"></i> Items</div>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead><tr><th>Job</th><th>Origin</th><th>Kind</th><th>State</th><th>Scope</th><th>Spokes</th></tr></thead>
              <tbody id="items"></tbody>
            </table>
          </div>
        </div>
        <div class="card">
          <div class="card-header"><i class="bi bi-inbox"></i> Assigned to the bot <small class="text-body-secondary" id="swept"></small></div>
          <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
              <thead><tr><th>Issue</th><th>Title</th><th>Updated</th><th>Status</th></tr></thead>
              <tbody id="assigned"></tbody>
            </table>
          </div>
        </div>
      </section>

      <section class="tab-pane fade" id="harness">
        <div class="card mb-3">
          <div class="card-body" id="marketplace"></div>
        </div>
        <div class="card">
          <div class="table-responsive">
            <table class="table table-sm harness mb-0">
              <thead id="harness-head"></thead>
              <tbody id="harness-body"></tbody>
            </table>
          </div>
        </div>
      </section>
    </div>
  </main>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.8/js/bootstrap.bundle.min.js" integrity="sha512-HvOjJrdwNpDbkGJIG2ZNqDlVqMo77qbs4Me4cah0HoDrfhrbA+8SBlZn1KrvAQw7cILLPFJvdwIgphzQmMm+Pw==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
  <script>
    const base = '<%= url_for('/') %>'.replace(/\/$/, '');
    const minion = '<%= url_for('/minion') %>';
    const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    const when = t => t ? new Date(t * 1000).toLocaleString() : '';
    const stateColor = { active: 'primary', inactive: 'secondary', finished: 'success', failed: 'danger' };
    const badge = (text, color) => `<span class="badge text-bg-${color}">${esc(text)}</span>`;
    const statusBadge = { pass: badge('pass', 'success'), fail: badge('fail', 'danger'), info: badge('info', 'secondary'), skip: badge('skip', 'light') };
    const jobLink = id => `<a href="${minion}/jobs?id=${encodeURIComponent(id)}">#${esc(id)}</a>`;

    function card(title, value, sub, icon) {
      return `<div class="col-6 col-md-3"><div class="card h-100"><div class="card-body">
        <div class="text-body-secondary small"><i class="bi bi-${icon}"></i> ${esc(title)}</div>
        <div class="stat my-1">${esc(value)}</div><div class="small text-body-secondary">${esc(sub)}</div></div></div></div>`;
    }

    function meter(window) {
      if (!window) return ['n/a', 'no run reported it yet'];
      return [`${window.percent}%`, window.resets_at ? `resets ${when(window.resets_at)}` : ''];
    }

    async function overview() {
      const d = await (await fetch(`${base}/api/overview`)).json();
      const b = d.budget, five = meter(b.five_hour), seven = meter(b.seven_day);
      const a = d.activity;
      const opened = a ? `↑ ${a.opened_7d} ${a.opened_7d === 1 ? 'issue' : 'issues'} in last 7 days` : 'no sweep yet';
      document.getElementById('cards').innerHTML =
        card('Open issues', a ? a.unassigned : '–', opened, 'exclamation-circle') +
        card('PRs merged', a ? a.merged_7d : '–', a ? 'in last 7 days' : 'no sweep yet', 'git') +
        card('In progress', d.items.active, 'items being worked', 'play-circle') +
        card('Queued', d.items.inactive, 'items waiting', 'hourglass-split') +
        card('Failed', d.items.failed, 'items that need a person', 'x-octagon') +
        card('Quota, 5 hours', five[0], five[1], 'speedometer2') +
        card('Quota, 7 days', seven[0], seven[1], 'calendar-week') +
        card('Cost, 7 days', `$${b.cost_7d.toFixed(2)}`, `${b.runs_7d} runs, $${b.cost_24h.toFixed(2)} today`, 'currency-dollar');
      document.getElementById('running').textContent = d.running ? d.running.short : '';
      actions = d.actions;
      drawActions();
    }

    // The server sends every action item.  The page keeps the list and the
    // types that are switched off, so a refresh draws the same choice again.
    let actions = [];
    const hiddenLevels = new Set();
    const level = { info: 'info', warning: 'warning', danger: 'danger' };

    function drawActions() {
      const shown = actions.filter(a => !hiddenLevels.has(a.level));
      document.getElementById('actions').innerHTML = shown.length
        ? shown.map(a => `<li class="list-group-item list-group-item-${level[a.level] || 'secondary'} d-flex align-items-start gap-2">
            <div class="flex-grow-1">${a.job ? jobLink(a.job) + ' ' : ''}${esc(a.text)}${a.link ? ` <a href="${esc(a.link.url)}">${esc(a.link.label)}</a>` : ''}</div>${buttons(a)}</li>`).join('')
        : actions.length
          ? '<li class="list-group-item text-body-secondary"><i class="bi bi-funnel"></i> The filter hides every action item.</li>'
          : '<li class="list-group-item text-success"><i class="bi bi-check-circle"></i> Nothing needs you.</li>';
    }

    document.getElementById('action-filter').addEventListener('click', e => {
      const button = e.target.closest('button[data-level]');
      if (!button) return;
      const off = button.classList.toggle('active') === false;
      button.setAttribute('aria-pressed', String(!off));
      off ? hiddenLevels.add(button.dataset.level) : hiddenLevels.delete(button.dataset.level);
      drawActions();
    });

    const buttons = a => (a.buttons || []).map(b => `<button type="button" class="btn btn-sm act text-nowrap"
      data-act="${esc(b.act)}" data-body="${esc(JSON.stringify(b.body || {}))}">${esc(b.label)}</button>`).join('');

    // Every action needs this header, which no other site can make the browser send.
    document.getElementById('actions').addEventListener('click', async e => {
      const button = e.target.closest('button[data-act]');
      if (!button) return;
      button.disabled = true;
      const res = await fetch(`${base}/act/${button.dataset.act}`, {
        method: 'POST', headers: { 'X-Clod-Action': 'yes', 'Content-Type': 'application/json' }, body: button.dataset.body,
      });
      if (!res.ok) {
        button.textContent = (await res.json().catch(() => ({}))).error || `failed: ${res.status}`;
        return;
      }
      refresh();
    });

    async function work() {
      const d = await (await fetch(`${base}/api/work`)).json();
      document.getElementById('items').innerHTML = d.items.map(i => `<tr>
        <td>${jobLink(i.id)}<div class="small text-body-secondary">${esc(when(i.created))}</div></td>
        <td>${i.url ? `<a href="${esc(i.url)}">${esc(i.origin)}</a>` : ''}<div class="small summary text-truncate">${esc(i.title)}</div></td>
        <td>${esc(i.kind)}</td>
        <td>${badge(i.state, stateColor[i.state] || 'secondary')}</td>
        <td>${i.scope ? badge(i.scope, 'info') : ''}<div class="small summary text-body-secondary">${esc(i.reason)}</div></td>
        <td>${i.children.map(c => `<div>${jobLink(c.id)} ${badge(c.state, stateColor[c.state] || 'secondary')} ${esc(c.repo || c.task)}
          ${c.repo_url ? `${badge('new repository', 'success')} <a href="${esc(c.repo_url)}"><i class="bi bi-box-arrow-up-right"></i></a>` : ''}
          ${c.release_url ? `<a href="${esc(c.release_url)}" title="release issue"><i class="bi bi-tag"></i></a>` : ''}
          ${(c.issue_urls || []).map(u => `<a href="${esc(u)}" title="follow-up issue"><i class="bi bi-record-circle"></i></a>`).join(' ')}
          ${c.pr_url ? `<a href="${esc(c.pr_url)}"><i class="bi bi-box-arrow-up-right"></i></a>` : ''}</div>`).join('')}</td>
      </tr>`).join('') || '<tr><td colspan="6" class="text-body-secondary">No items yet.</td></tr>';
      document.getElementById('swept').textContent = d.swept_at ? `as of ${when(d.swept_at)}` : '';
      document.getElementById('assigned').innerHTML = d.assigned.map(a => `<tr>
        <td><a href="${esc(a.url)}">${esc(a.repo)}#${esc(a.number)}</a> ${a.is_pr ? badge('PR', 'secondary') : ''}</td>
        <td>${esc(a.title)}</td><td class="small">${esc(a.updated_at)}</td>
        <td>${a.has_job ? badge('has a job', 'primary') : badge('waiting', 'warning')}</td></tr>`).join('')
        || '<tr><td colspan="4" class="text-body-secondary">Nothing assigned.</td></tr>';
    }

    async function harness() {
      const d = await (await fetch(`${base}/api/harness`)).json();
      const m = d.marketplace;
      document.getElementById('marketplace').innerHTML = m
        ? `${statusBadge[m.status] || ''} <strong>${esc(m.plugin)}</strong> marketplace pin: ${esc(m.detail)}. <span class="text-body-secondary small">Scanned ${esc(when(d.checked_at))}.</span>`
        : '<span class="text-body-secondary">No harness scan has finished yet.</span>';
      const checks = d.checks || [];
      document.getElementById('harness-head').innerHTML = `<tr><th>Spoke</th><th class="small">Flavor</th>${checks.map(c => `<th class="text-center small">${esc(c)}</th>`).join('')}</tr>`;
      const repos = Object.keys(d.repos || {}).sort();
      document.getElementById('harness-body').innerHTML = repos.map(r => {
        const byName = Object.fromEntries(d.repos[r].checks.map(c => [c.check, c]));
        const flavor = d.repos[r].chosen ? esc(d.repos[r].flavor) : `${esc(d.repos[r].flavor)} <span class="text-body-secondary">(default)</span>`;
        return `<tr><th>${esc(r)}</th><td class="small">${flavor}</td>${checks.map(c => {
          const x = byName[c];
          return x ? `<td class="cell" title="${esc(x.detail)}">${statusBadge[x.status] || esc(x.status)}</td>` : '<td></td>';
        }).join('')}</tr>`;
      }).join('') + Object.entries(d.errors || {}).map(([r, e]) => `<tr><th>${esc(r)}</th><td colspan="${checks.length + 1}" class="text-danger small">${esc(e)}</td></tr>`).join('');
    }

    async function refresh() {
      try {
        await Promise.all([overview(), work(), harness()]);
        document.getElementById('updated').textContent = `updated ${new Date().toLocaleTimeString()}`;
      } catch (e) {
        document.getElementById('updated').textContent = `refresh failed: ${e}`;
      }
    }
    refresh();
    setInterval(refresh, 30000);
  </script>
</body>
</html>
